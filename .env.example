# Which release to run: the images ghcr.io/lowicz/oncall-api and oncall-web
# are pulled with this tag (a version such as 1.2.0, or 1.2 / 1 for the newest
# patch / minor). Compose refuses to start while it is empty, so every host
# states what it runs and a rollback is this one line. Developers building from
# the checkout (docker-compose.dev.yml) set it to anything, e.g. dev.
# Release list and verification: docs/wdrozenie/wydania.md.
ONCALL_VERSION=
# Developers: uncomment so that a plain `docker compose up --build` builds the
# images from this checkout instead of pulling a release.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Brand shown in the interface, e-mails and calendar names, and the optional
# second line under it in the navigation rail and on the login screen.
ONCALL_APP_NAME=On-call
ONCALL_APP_SUBTITLE=

ONCALL_DATABASE_URL=postgresql+asyncpg://oncall:oncall@db:5432/oncall
ONCALL_DATABASE_POOL_SIZE=3
ONCALL_DATABASE_MAX_OVERFLOW=2
# Shared resolved-duty data used by calendar, published and fairness reads.
# Set to 0 for strict read-after-write visibility; the default bounds staleness
# between API workers to one second.
ONCALL_EFFECTIVE_ASSIGNMENTS_CACHE_SECONDS=1
# Authentication lookup cache per API process. Logout invalidates the serving
# process immediately; other workers converge within this bounded interval.
ONCALL_SESSION_CACHE_SECONDS=5
ONCALL_SESSION_COOKIE_SECURE=false
ONCALL_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
ONCALL_ADMIN_USERNAME=admin
ONCALL_ADMIN_PASSWORD=replace-with-at-least-12-characters
ONCALL_ADMIN_DISPLAY_NAME=Administrator

# Optional LDAP / Active Directory login. Local accounts always remain active.
ONCALL_LDAP_ENABLED=false
ONCALL_LDAP_SERVER_URI=ldap://ad.example.com:389
ONCALL_LDAP_BIND_DN=CN=oncall-service,OU=Service Accounts,DC=example,DC=com
ONCALL_LDAP_BIND_PASSWORD=replace-me
ONCALL_LDAP_BASE_DN=DC=example,DC=com
ONCALL_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
ONCALL_LDAP_START_TLS=true
ONCALL_LDAP_CONNECT_TIMEOUT_SECONDS=5
# PEM bundle of the CA that issued the directory's certificate, when that CA is
# an internal one (AD CS). A path on the host, mounted into the API by the
# docker-compose.ldap-ca.yml overlay; the default is the TLS overlay's bundle.
# ONCALL_LDAP_CA_FILE=./tls/ca.pem
ONCALL_LDAP_ATTRIBUTE_PERSONNEL_NUMBER=employeeNumber
ONCALL_LDAP_ATTRIBUTE_FIRST_NAME=givenName
ONCALL_LDAP_ATTRIBUTE_LAST_NAME=sn
ONCALL_LDAP_ATTRIBUTE_EMAIL=mail
POSTGRES_DB=oncall
POSTGRES_USER=oncall
POSTGRES_PASSWORD=oncall

# External SMTP service for e-mail notifications (not hosted by this project).
# Leave ONCALL_SMTP_HOST empty to skip e-mail delivery.
ONCALL_SMTP_HOST=
ONCALL_SMTP_PORT=587
ONCALL_SMTP_USERNAME=
ONCALL_SMTP_PASSWORD=
# FQDN sent in EHLO/HELO when the SMTP server requires a specific client name.
ONCALL_SMTP_LOCAL_HOSTNAME=
ONCALL_SMTP_USE_TLS=false
ONCALL_SMTP_STARTTLS=true
ONCALL_EMAIL_FROM="On-call <oncall@example.com>"

# Base URL used in notification e-mails, ICS feed URLs and share links.
ONCALL_PUBLIC_BASE_URL=http://localhost:8080
ONCALL_HANDOVER_REMINDER_HOUR=9

# CP-SAT generator: parallel workers and diagnostics. ONCALL_SOLVER_SECONDS only
# seeds the scheduling policy's budget when that row is first created; afterwards
# the budget is edited in the app ("Ustawienia generowania", 5-300 s).
ONCALL_SOLVER_WORKERS=8
ONCALL_SOLVER_SECONDS=15
ONCALL_SOLVER_LOG=false

# API worker processes. Empty derives the count from cgroup CPU quota or
# process affinity, with a minimum of two. Keep workers × DB pool below the
# PostgreSQL max_connections limit.
ONCALL_API_WORKERS=

# HTTPS for the web container (nginx). Full guide: docs/wdrozenie/tls.md.
# TLS is an overlay, not a switch in the base compose file:
#
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
#
# The overlay sets ONCALL_TLS_ENABLED=true and mounts three separate files, so
# the certificate, the key and the trust bundle can come from three different
# places and be rotated one at a time. All three must exist before the
# container starts.
#   ONCALL_TLS_CERT_FILE  the server certificate alone, without its chain
#   ONCALL_TLS_KEY_FILE   its private key, unencrypted
#   ONCALL_TLS_CA_FILE    the complete system trust CA bundle; it is added to
#                         the container trust store and used as
#                         ssl_trusted_certificate
ONCALL_TLS_CERT_FILE=./tls/cert.pem
ONCALL_TLS_KEY_FILE=./tls/privkey.pem
ONCALL_TLS_CA_FILE=./tls/ca.pem
ONCALL_WEB_HTTP_PORT=8080
ONCALL_WEB_HTTPS_PORT=8443
# Set ONCALL_SESSION_COOKIE_SECURE=true and an https:// ONCALL_PUBLIC_BASE_URL
# when TLS is enabled.
