// Renovate keeps every dependency of this repository current: the SHA-pinned
// GitHub Actions, the npm and uv lockfiles, the container base images and the
// tool versions CI repeats in its workflow files. The Renovate GitHub App
// (Mend) reads this file; nothing runs inside this repository and no secret
// is stored here. The Dependency Dashboard issue shows what is pending.
//
// Shape:
//   - one pull request a week per ecosystem for minor and patch updates,
//     opened before working hours on Monday, Warsaw time;
//   - major updates of the runtimes (Python, Node, PostgreSQL) only after a
//     maintainer ticks them on the dashboard - they are decisions, not chores;
//   - security updates at any time, on their own, labelled;
//   - no automerge: the repository is public and one person maintains it, so
//     every change lands through a reviewed pull request that passed `ci-ok`;
//   - a release must be at least three days old before it is proposed, so a
//     freshly published (and possibly hijacked) package cannot reach a pull
//     request the same hour it appears.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    // Actions stay pinned to a full commit SHA with the version as a comment,
    // exactly the form the workflows use; Renovate moves both together.
    'helpers:pinGitHubActionDigests',
    // Base images pinned to their digest as well; the tag stays readable.
    'docker:pinDigests',
  ],
  timezone: 'Europe/Warsaw',
  schedule: ['before 6am on monday'],
  prConcurrentLimit: 5,
  prHourlyLimit: 3,
  labels: ['dependencies'],
  semanticCommitType: 'chore',
  configMigration: true,
  // Supply chain: wait for a release to age before proposing it, and rely on
  // GitHub's own vulnerability data to break that rule when it matters.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['dependencies', 'security'],
    schedule: ['at any time'],
    minimumReleaseAge: null,
    groupName: null,
  },
  // In-range updates only touch the lockfile; out-of-range ones widen the
  // range in pyproject.toml / package.json as well.
  rangeStrategy: 'update-lockfile',
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on the first day of the month'],
  },
  ignorePaths: ['archive/**'],
  enabledManagers: ['github-actions', 'npm', 'pep621', 'dockerfile', 'docker-compose', 'custom.regex'],
  customManagers: [
    {
      // The uv version CI installs (astral-sh/setup-uv `version`) and the uv
      // binary the backend image copies in must stay the same release.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['UV_VERSION: "(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"'],
      depNameTemplate: 'astral-sh/uv',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      // The Node major CI tests with (`NODE_VERSION`, `node-version`) is the
      // one the web image is built with (frontend/Dockerfile).
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['NODE_VERSION: "(?<currentValue>[0-9]+)"', 'node-version: "(?<currentValue>[0-9]+)"'],
      depNameTemplate: 'node',
      datasourceTemplate: 'node-version',
      versioningTemplate: 'node',
    },
    {
      // Same for Python and the backend image.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['PYTHON_VERSION: "(?<currentValue>[0-9]+\\.[0-9]+)"'],
      depNameTemplate: 'python',
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      // The PostgreSQL service container of the CI job (docker-compose.yml is
      // read by the docker-compose manager).
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['image: (?<depName>postgres):(?<currentValue>[0-9]+-alpine)'],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  packageRules: [
    // ---- one pull request per ecosystem for the routine updates ------------
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
    },
    {
      matchManagers: ['npm'],
      groupName: 'frontend (npm)',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchManagers: ['pep621'],
      groupName: 'backend (python)',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchManagers: ['dockerfile', 'docker-compose'],
      groupName: 'container base images',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
    },
    // ---- tool versions that appear in more than one file move together ------
    {
      matchDepNames: ['astral-sh/uv', 'ghcr.io/astral-sh/uv'],
      groupName: 'uv',
    },
    {
      matchDepNames: ['node'],
      groupName: 'Node.js',
    },
    {
      matchDepNames: ['python'],
      groupName: 'Python',
    },
    {
      matchDepNames: ['postgres'],
      groupName: 'PostgreSQL',
    },
    // ---- runtimes and majors are decisions: dashboard approval first --------
    {
      matchDepNames: ['node', 'python', 'postgres'],
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'runtime'],
    },
    {
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'major'],
    },
    // Python minors (3.14 -> 3.15) change the interpreter; treat them as majors.
    {
      matchDepNames: ['python'],
      matchUpdateTypes: ['minor'],
      labels: ['dependencies', 'runtime', 'major'],
    },
    // ---- the frontend's MUI packages release together; keep them together ---
    {
      matchManagers: ['npm'],
      matchPackageNames: ['/^@mui\\//', '/^@emotion\\//'],
      groupName: 'frontend (MUI)',
    },
  ],
}
