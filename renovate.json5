// Renovate keeps every dependency of this repository current: the SHA-pinned
// GitHub Actions, the npm and uv lockfiles, the container base images and the
// tool versions CI repeats in its workflow files. The Renovate GitHub App
// (Mend) reads this file; nothing runs inside this repository and no secret
// is stored here. The Dependency Dashboard issue shows what is pending.
//
// Shape:
//   - one pull request a week per ecosystem for minor and patch updates,
//     opened before working hours on Monday, Warsaw time;
//   - major updates, and every update of a runtime (Python, Node,
//     PostgreSQL), only after a maintainer approves them - they are decisions,
//     not chores. The exception is a bug-fix release of the runtime already
//     in use (Python 3.14.8 -> 3.14.9, PostgreSQL 18.6 -> 18.7): it comes in
//     its own weekly pull request;
//   - a version that appears in several files is read from one datasource
//     in all of them, so every file gets the same version on the same day;
//   - security updates at any time, on their own, labelled;
//   - no automerge: the repository is public and one person maintains it, so
//     every change lands through a reviewed pull request that passed `ci-ok`;
//   - a release must be at least three days old before it is proposed, so a
//     freshly published (and possibly hijacked) package cannot reach a pull
//     request the same hour it appears. Where no release date exists (the
//     postgres image, lock file maintenance) the update is proposed without
//     that wait; the rules below say why.
//
// Approving a major or runtime update: open the Dependency Dashboard issue and
// tick the update's checkbox under "Pending Approval". Renovate opens the pull
// request on its next run, schedule or not, with the lockfiles regenerated.
// Never start one by editing a version on a branch by hand - that skips the
// grouping and the lockfile update. Code changes the update needs are pushed
// to the pull request Renovate opened; Renovate then stops rebasing it, and
// ticking its rebase box would drop them. Before merging a runtime update,
// `git grep` the old version on its branch: what is left is prose (docs/,
// AGENTS.md) to update in the same pull request, or a new reference that
// belongs in the group's custom manager below.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    // Actions stay pinned to a full commit SHA with the version as a comment,
    // exactly the form the workflows use; Renovate moves both together.
    'helpers:pinGitHubActionDigests',
    // No docker:pinDigests: images are referenced by tag. The node and
    // python tags follow the runtimes' own release lists (custom managers
    // below), which have no digests, so Renovate could not move a digest
    // with the tag - and Docker runs the digest when both are written. The
    // nginx and postgres tags name one release each (`1.31.6-alpine`,
    // `18.6-alpine`), so a new release reaches a build or an installation
    // only through a reviewed pull request. The publisher can still rebuild
    // a release under its tag (new Alpine packages, same version);
    // release.yml records each base image digest in the published image's
    // provenance.
  ],
  timezone: 'Europe/Warsaw',
  schedule: ['before 6am on monday'],
  prConcurrentLimit: 5,
  prHourlyLimit: 3,
  labels: ['dependencies'],
  semanticCommitType: 'chore',
  configMigration: true,
  // Supply chain: wait for a release to age before proposing it, and rely on
  // GitHub's own vulnerability data to break that rule when it matters.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['dependencies', 'security'],
    schedule: ['at any time'],
    minimumReleaseAge: null,
    groupName: null,
  },
  // In-range updates only touch the lockfile; out-of-range ones widen the
  // range in pyproject.toml / package.json as well.
  rangeStrategy: 'update-lockfile',
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on the first day of the month'],
  },
  ignorePaths: ['archive/**'],
  enabledManagers: ['github-actions', 'npm', 'pep621', 'dockerfile', 'docker-compose', 'custom.regex'],
  customDatasources: {
    'python-releases': {
      defaultRegistryUrlTemplate: 'https://www.python.org/api/v2/downloads/release/',
      transformTemplates: [
        '{"releases": [$[is_published = true and pre_release = false and $contains(name, /^Python [0-9]+\\.[0-9]+\\.[0-9]+$/)].{"version": $substringAfter(name, "Python "), "releaseTimestamp": release_date}], "homepage": "https://www.python.org/downloads/", "sourceUrl": "https://github.com/python/cpython"}',
      ],
    },
    // The nginx releases published as `nginxinc/nginx-unprivileged:<version>-alpine`,
    // with the date each tag was pushed, for the nginx custom manager below. One
    // anonymous page of Docker Hub's tag list: the 100 most recently pushed
    // tags with `-alpine` in the name hold the newest releases, which is all
    // an update needs; the pinned release itself need not be among them.
    'nginx-unprivileged': {
      defaultRegistryUrlTemplate: 'https://hub.docker.com/v2/repositories/nginxinc/nginx-unprivileged/tags?page_size=100&ordering=last_updated&name=-alpine',
      transformTemplates: [
        '{"releases": [results[$contains(name, /^[0-9]+\\.[0-9]+\\.[0-9]+-alpine$/)].{"version": $substringBefore(name, "-alpine"), "releaseTimestamp": tag_last_pushed}], "sourceUrl": "https://github.com/nginx/docker-nginx-unprivileged"}',
      ],
    },
  },
  customManagers: [
    {
      // One uv release writes and reads backend/uv.lock: the one CI installs
      // (`UV_VERSION`), the binary the backend image copies in, and
      // `required-version` in pyproject.toml, which uv enforces and Renovate
      // installs for its own lockfile updates. One dependency from one
      // datasource, so all three get the same version on the same day.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.ya?ml$/',
        '/^backend/Dockerfile$/',
        '/^backend/pyproject\\.toml$/',
      ],
      matchStrings: [
        'UV_VERSION: "(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"',
        'ghcr\\.io/astral-sh/uv:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)',
        'required-version = "==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"',
      ],
      depNameTemplate: 'astral-sh/uv',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      // One Node major: CI (`NODE_VERSION`, `node-version` in pages.yml) and
      // the web image (frontend/Dockerfile), all from Node's own release
      // list. Read from Docker Hub instead, the image line would have its own
      // release date - Docker Hub dates a floating tag such as `22-alpine` by
      // its last push - and an approved runtime update moves only the
      // members past the three-day rule, so the image could stay on the old
      // major while CI moved on. Docker Hub publishes `<major>-alpine` for
      // every Node major; the image-build job fails a pull request if not.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.ya?ml$/',
        '/^frontend/Dockerfile$/',
        '/^README\\.md$/',
      ],
      matchStrings: [
        'NODE_VERSION: "(?<currentValue>[0-9]+)"',
        'node-version: "(?<currentValue>[0-9]+)"',
        'FROM node:(?<currentValue>[0-9]+)-alpine',
        // The version badge in README.md, so the badge and the runtime move in
        // the same pull request.
        'shields\\.io/badge/Node\\.js-(?<currentValue>[0-9]+)-',
        'alt="Node\\.js (?<currentValue>[0-9]+)"',
      ],
      depNameTemplate: 'node',
      datasourceTemplate: 'node-version',
      versioningTemplate: 'node',
    },
    {
      // CI, the image and the badge name the same Python patch release.
      // python.org dates stable releases; the pep621 interpreter bound uses
      // this source too, so one age gate applies across the group.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.ya?ml$/',
        '/^backend/Dockerfile$/',
        '/^README\\.md$/',
      ],
      matchStrings: [
        'PYTHON_VERSION: "(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"',
        'python:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-slim',
        // The version badge in README.md.
        'shields\\.io/badge/Python-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-',
        'alt="Python (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"',
      ],
      depNameTemplate: 'python',
      datasourceTemplate: 'custom.python-releases',
      versioningTemplate: 'python',
    },
    {
      // The PostgreSQL major written as a bare number: the version badge in
      // README.md and the data volume name in docker-compose.yml
      // (`oncall-postgres-<major>`). The image lines name one release
      // (`postgres:18.6-alpine` in both Compose files and the ci.yml service)
      // and are read by the docker-compose and github-actions managers from
      // the same Docker Hub image, so the "PostgreSQL" group moves them with
      // these. Docker versioning compares tags of the same shape only: `18`
      // moves to another bare major alone, so a minor release (18.6 -> 18.7)
      // changes the image lines and nothing else, while a new major changes
      // the badge and the volume name in the same pull request. A major bump
      // is a data move (deploy/update.sh, oncall-backup.sh upgrade-postgres):
      // the new image must mount a new volume, named after that major.
      // compose-postgres-volume.sh refuses a Compose file whose volume major
      // disagrees with the image, and an image line in another file that
      // names a different release.
      customType: 'regex',
      managerFilePatterns: ['/^README\\.md$/', '/^docker-compose\\.yml$/'],
      matchStrings: [
        'shields\\.io/badge/PostgreSQL-(?<currentValue>[0-9]+)-',
        'alt="PostgreSQL (?<currentValue>[0-9]+)"',
        'oncall-postgres-(?<currentValue>[0-9]+)',
      ],
      depNameTemplate: 'postgres',
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      // nginx: the base image of the web image (frontend/Dockerfile), pinned
      // to one release. Only the version number is captured and moved, so the
      // tag keeps its `-alpine` variant and can never become a floating one
      // such as `1.31-alpine`; semver puts a new nginx major behind dashboard
      // approval. Not read by the dockerfile manager: Docker Hub shows an
      // anonymous client the push dates of the first 1000 tags only, this
      // image has more, and Renovate's docker lookup then drops the dates of
      // every tag, so the three-day rule would hold each nginx update in
      // "Pending Status Checks" until someone forced it. The
      // "nginx-unprivileged" datasource above reads the dates directly.
      customType: 'regex',
      managerFilePatterns: ['/^frontend/Dockerfile$/'],
      matchStrings: ['FROM nginxinc/nginx-unprivileged:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-alpine\\s'],
      depNameTemplate: 'nginxinc/nginx-unprivileged',
      datasourceTemplate: 'custom.nginx-unprivileged',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    // ---- one pull request per ecosystem for the routine updates ------------
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
    },
    {
      matchManagers: ['npm'],
      groupName: 'frontend (npm)',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchManagers: ['pep621'],
      groupName: 'backend (python)',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchManagers: ['pep621'],
      // uv cannot be told to lock exactly Renovate's selected in-range version;
      // pin direct app dependencies so pyproject.toml and uv.lock move together
      // and minimumReleaseAge cannot be bypassed by the resolver.
      rangeStrategy: 'pin',
    },
    {
      // requires-python is the interpreter bound, not a dependency: it stays a
      // range and the dashboard-gated "Python" group moves it with the runtime.
      matchManagers: ['pep621'],
      matchDepTypes: ['requires-python'],
      rangeStrategy: 'update-lockfile',
      overrideDatasource: 'custom.python-releases',
    },
    {
      matchManagers: ['dockerfile', 'docker-compose'],
      groupName: 'container base images',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      // The nginx base image, read by its own manager, in the same weekly pull
      // request as the other base images.
      matchDepNames: ['nginxinc/nginx-unprivileged'],
      groupName: 'container base images',
      matchUpdateTypes: ['minor', 'patch'],
    },
    // ---- tool versions that appear in more than one file move together ------
    {
      matchDepNames: ['astral-sh/uv'],
      groupName: 'uv',
    },
    {
      // Image lines that belong to the custom managers above. Read by the
      // dockerfile manager they would be separate dependencies with their own
      // release dates (GHCR publishes none, Docker Hub dates a tag by its last
      // push), and a group moves only the members that pass the three-day
      // rule. The nginx line would be an undated second copy of the nginx
      // custom manager's dependency.
      matchManagers: ['dockerfile'],
      matchDepNames: ['ghcr.io/astral-sh/uv', 'node', 'python', 'nginxinc/nginx-unprivileged'],
      enabled: false,
    },
    {
      // Same for the `node-version` input of actions/setup-node in pages.yml,
      // which the github-actions manager would look up in the
      // actions/node-versions releases instead. (It also reads the postgres
      // service image of ci.yml; that one stays, in the PostgreSQL group.)
      matchManagers: ['github-actions'],
      matchDepNames: ['node'],
      enabled: false,
    },
    {
      matchDepNames: ['node'],
      groupName: 'Node.js',
    },
    {
      matchDepNames: ['python'],
      groupName: 'Python',
      // A new minor waits for approval (and for wheels such as ortools'), so
      // the next patch of the current minor gets its own pull request.
      separateMinorPatch: true,
    },
    {
      matchDepNames: ['postgres'],
      groupName: 'PostgreSQL',
      // Docker Hub shows an anonymous client the push dates of the first 1000
      // tags only, this image has more, so the three-day rule would hold
      // every PostgreSQL update in "Pending Status Checks" for ever. Without
      // the dates there is no wait: a minor release is proposed on the first
      // Monday after Docker Hub has it (scheduled minors come out on a
      // Thursday), a major waits for dashboard approval.
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      // Lock file maintenance and pinning move to no new release, so they have
      // no release date; with the date required they never pass the three-day
      // rule. Keeping minimumReleaseAge lets npm still resolve with --before.
      matchUpdateTypes: ['lockFileMaintenance', 'pin'],
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    // ---- runtimes and majors are decisions: dashboard approval first --------
    {
      matchDepNames: ['node', 'python', 'postgres'],
      dependencyDashboardApproval: true,
      addLabels: ['runtime'],
    },
    {
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      addLabels: ['major'],
    },
    {
      // A CPython patch release (3.14.8 -> 3.14.9) carries only bug and
      // security fixes and moves the image, CI and badge together: it comes in
      // its own weekly pull request like the nginx patches, no approval.
      matchDepNames: ['python'],
      matchUpdateTypes: ['patch'],
      dependencyDashboardApproval: false,
    },
    {
      // The same for a PostgreSQL minor release (18.6 -> 18.7): bug and
      // security fixes on the data directory the major already wrote, no
      // dump or new volume. A new major still waits for approval, and its
      // pull request is separate, so a pending one holds no minor back.
      matchDepNames: ['postgres'],
      matchUpdateTypes: ['minor'],
      dependencyDashboardApproval: false,
    },
    // Python minors (3.14 -> 3.15) change the interpreter; treat them as majors.
    {
      matchDepNames: ['python'],
      matchUpdateTypes: ['minor'],
      addLabels: ['major'],
    },
    // ---- @vitest/coverage-v8 requires the exact vitest release; one PR ------
    {
      matchManagers: ['npm'],
      matchPackageNames: ['vitest', '/^@vitest\\//'],
      groupName: 'frontend (vitest)',
    },
    // ---- @vitejs/plugin-react peers on one vite major; one PR --------------
    {
      matchManagers: ['npm'],
      matchPackageNames: ['vite', '@vitejs/plugin-react'],
      groupName: 'frontend (vite)',
    },
    // ---- the ESLint plugins peer on one eslint major; one PR ---------------
    // A new eslint major resolves only together with the plugin releases that
    // accept it (eslint 10 needed eslint-plugin-react-hooks 7), and the
    // react-hooks plugin would otherwise ride in the React monorepo group.
    {
      matchManagers: ['npm'],
      matchPackageNames: [
        'eslint',
        '@eslint/js',
        'eslint-plugin-react-hooks',
        'eslint-plugin-react-refresh',
        'typescript-eslint',
      ],
      groupName: 'frontend (eslint)',
    },
    // ---- @types/node follows the Node major the runtime uses; one approval ---
    {
      matchDepNames: ['@types/node'],
      matchUpdateTypes: ['major'],
      groupName: 'Node.js',
    },
    // ---- TypeScript minors can break the type-check; keep them apart --------
    // Both entries are npm aliases, so they are matched by depName.
    {
      matchManagers: ['npm'],
      matchDepNames: ['@typescript/native', 'typescript'],
      groupName: 'frontend (typescript)',
    },
  ],
}
