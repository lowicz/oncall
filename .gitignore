# --- Secrets and local configuration ---
.env
.env.local
.env.*.local
!.env.example
# Backups made by deploy/update.sh in the deployment directory (including .env with secrets)
/.backup/

# Locally generated certificates (docs/wdrozenie/tls.md describes how to recreate them)
tls/
*.pem
*.key
*.crt
*.p12

# --- Python / backend ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- Node / frontend ---
node_modules/
dist/
# Documentation rendered from docs/*.md by frontend/scripts/build-docs.mjs:
# the copy in the image (public/docs) and the standalone site (site/, GitHub Pages).
frontend/public/docs/
site/
.vite/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Data and runtime state ---
*.db
*.sqlite
*.sqlite3
state_*.json

# --- Agent tooling: generated surfaces and personal configuration ---
# .lavish/ holds generated HTML pages and screenshots for review - they stay local.
.lavish/
.codex/
.claude/settings.local.json
.aider*

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
